<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LiveCoinCounter.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LiveCoinCounter.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Conta"
            ContentTemplate="{DataTemplate views:CapturePage}"
            Icon="coin_icon.png"
            Route="CapturePage" />

        <ShellContent
            Title="Sessioni"
            ContentTemplate="{DataTemplate views:SessionsPage}"
            Icon="sessions_icon.png"
            Route="SessionsPage" />

        <ShellContent
            Title="Impostazioni"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Icon="settings_icon.png"
            Route="SettingsPage" />
    </TabBar>

</Shell>
