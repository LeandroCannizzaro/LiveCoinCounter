<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LiveCoinCounter</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Versione app -->
    <ApplicationTitle>Conteggio Monete</ApplicationTitle>
    <ApplicationId>com.LiveCoinCounter.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Android specifico -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- Solo 64 bit: le librerie native di OpenCV per tutte le architetture pesano oltre 100 MB.
         Release (APK distribuito): solo arm64, i telefoni. Debug: anche x64, per l'emulatore. -->
    <RuntimeIdentifiers Condition="'$(Configuration)' == 'Release'">android-arm64</RuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(Configuration)' != 'Release'">android-arm64;android-x64</RuntimeIdentifiers>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Risorse app (icone, splash, font, immagini) -->
  <ItemGroup>
    <!-- Icona app -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Immagini -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Font -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Assets raw -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Libreria condivisa con l'etichettatore (provider AI, modelli) -->
  <ItemGroup>
    <ProjectReference Include="..\Recognition.Core\Recognition.Core.csproj" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <!-- Fotocamera: fotogrammi continui per il riconoscimento continuo (metodo OpenCV) -->
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.2" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.2" />
    <!-- CameraX porta AndroidX.Core 1.19: core-ktx deve avere la stessa versione, altrimenti le classi Kotlin risultano doppie -->
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
  </ItemGroup>

  <!--
    Librerie Java da Maven per comporre il mosaico:
    - OpenCV (licenza Apache 2): ORB per i punti caratteristici. Non si genera il binding di tutta l'API Java: la usa solo
      la piccola classe Java OrbHelper (Platforms/Android/Java), di cui si genera il binding.
    - ARCore (termini aggiuntivi Google ARCore): posa della fotocamera e piano del tavolo, per i metodi ARCore e Ibrido.
  -->
  <ItemGroup>
    <AndroidMavenLibrary Include="org.opencv:opencv" Version="4.12.0" Bind="false" />
    <!-- dipendenze già presenti nell'app tramite MAUI (Kotlin e AndroidX), solo non dichiarate come pacchetti diretti -->
    <AndroidIgnoredJavaDependency Include="org.jetbrains.kotlin:kotlin-stdlib-jdk8:1.5.20" />
    <AndroidIgnoredJavaDependency Include="androidx.annotation:annotation:1.3.0" />
    <AndroidMavenLibrary Include="com.google.ar:core" Version="1.57.0" Repository="Google" />
    <TransformFile Include="Platforms\Android\Transforms\ArCoreMetadata.xml" />
    <AndroidJavaSource Include="Platforms\Android\Java\**\*.java" Bind="true" />
  </ItemGroup>

  <!--
    Il pacchetto Microsoft.ML.OnnxRuntime contiene le librerie native per Android (dentro onnxruntime.aar) ma anche quelle per
    Linux, Windows e macOS. Le librerie Linux hanno lo stesso nome di quelle Android (libonnxruntime.so): su un build Linux
    (GitHub Actions) finivano nell'APK al posto di quelle Android, e sul telefono l'app andava in errore (TypeInitializationException
    in Microsoft.ML.OnnxRuntime.NativeMethods). Si tengono solo le risorse Android.
  -->
  <Target Name="KeepOnlyAndroidOnnxRuntimeNatives" AfterTargets="ResolvePackageAssets;ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != 'android'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And '%(ReferenceCopyLocalPaths.AssetType)' == 'native' And '%(ReferenceCopyLocalPaths.RuntimeIdentifier)' != 'android'" />
    </ItemGroup>
  </Target>

  <!-- Stesso problema, nel punto in cui il build Android raccoglie le librerie .so da mettere nell'APK. -->
  <Target Name="DropDesktopNativeLibraries" BeforeTargets="_IncludeNativeSystemLibraries">
    <ItemGroup>
      <_DesktopNativeLibrary Include="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.so' And $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.FullPath)', '.runtimes.(linux|win|osx)'))" />
      <ResolvedFileToPublish Remove="@(_DesktopNativeLibrary)" />
    </ItemGroup>
  </Target>

</Project>
