<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>LiveCoinCounter</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Versione app -->
    <ApplicationTitle>LiveCoinCounter</ApplicationTitle>
    <ApplicationId>com.LiveCoinCounter.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Android specifico -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Risorse app (icone, splash, font, immagini) -->
  <ItemGroup>
    <!-- Icona app -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Immagini -->
    <MauiImage Include="Resources\Images\*" />

    <!-- Font -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Assets raw -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Libreria condivisa con l'etichettatore (provider AI, modelli) -->
  <ItemGroup>
    <ProjectReference Include="..\Recognition.Core\Recognition.Core.csproj" />
  </ItemGroup>

  <!-- NuGet packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <!--
    Il pacchetto Microsoft.ML.OnnxRuntime contiene le librerie native per Android (dentro onnxruntime.aar) ma anche quelle per
    Linux, Windows e macOS. Le librerie Linux hanno lo stesso nome di quelle Android (libonnxruntime.so): su un build Linux
    (GitHub Actions) finivano nell'APK al posto di quelle Android, e sul telefono l'app andava in errore (TypeInitializationException
    in Microsoft.ML.OnnxRuntime.NativeMethods). Si tengono solo le risorse Android.
  -->
  <Target Name="KeepOnlyAndroidOnnxRuntimeNatives" AfterTargets="ResolvePackageAssets;ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And '%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier)' != 'android'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime' And '%(ReferenceCopyLocalPaths.AssetType)' == 'native' And '%(ReferenceCopyLocalPaths.RuntimeIdentifier)' != 'android'" />
    </ItemGroup>
  </Target>

</Project>
