<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiveCoinCounter.ViewModels"
             x:Class="LiveCoinCounter.Views.SurfacePage"
             x:DataType="vm:SurfaceViewModel"
             Title="Superficie acquisita"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#101012">

    <Grid>
        <!-- La superficie: pizzica per ingrandire, trascina per spostarti, doppio tocco per ingrandire o tornare intero -->
        <Grid x:Name="Stage" BackgroundColor="#101012">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
            </Grid.GestureRecognizers>
            <Image x:Name="Surface" Source="{Binding Image}" Aspect="AspectFit" />
        </Grid>

        <!-- In alto: chiudi e titolo -->
        <Grid VerticalOptions="Start" Padding="12,44,12,8" ColumnDefinitions="Auto,*" ColumnSpacing="10" BackgroundColor="#66000000">
            <Button Text="✕" Command="{Binding CloseCommand}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" TextColor="White" BackgroundColor="#55FFFFFF"
                    SemanticProperties.Description="Chiudi la superficie a tutto schermo" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Title}" TextColor="White" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label Text="Pizzica per ingrandire · doppio tocco per ingrandire o tornare intero" TextColor="#BBFFFFFF" FontSize="11" />
            </VerticalStackLayout>
        </Grid>

        <!-- In basso: cosa mostrare -->
        <Border VerticalOptions="End" Margin="12,0,12,24" Padding="14,10" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="#CC1A1A1E">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="Riquadri e valori delle monete" TextColor="White" FontSize="14" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ShowBoxes}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding GridText}" TextColor="White" FontSize="14" />
                        <Label Text="{Binding ScaleText}" TextColor="#99FFFFFF" FontSize="11" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding ShowGrid}" IsEnabled="{Binding CanGrid}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasPhoto}">
                    <Label Text="Foto reale del tavolo" TextColor="White" FontSize="14" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding ShowPhoto}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White"
                           HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="44" />
    </Grid>
</ContentPage>
