<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiveCoinCounter.ViewModels"
             x:Class="LiveCoinCounter.Views.SurfacePage"
             x:DataType="vm:SurfaceViewModel"
             Title="Superficie acquisita"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#101012">

    <Grid>
        <!-- Solo la superficie, la più grande possibile: pizzica per ingrandire, trascina per spostarti, doppio tocco per ingrandire
             o tornare intero, tocca una moneta per i suoi dettagli. In una serie di scatti, swipe per passare da una superficie all'altra. -->
        <Grid x:Name="Stage" BackgroundColor="#101012">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer Tapped="OnTapped" />
            </Grid.GestureRecognizers>
            <Image x:Name="Surface" Source="{Binding Image}" Aspect="AspectFit" />
        </Grid>

        <!-- In alto: chiudi; in una serie anche «Superficie k di n» e la vista della superficie -->
        <Grid VerticalOptions="Start" Margin="12,44,12,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Text="✕" Command="{Binding CloseCommand}"
                    WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                    FontSize="20" TextColor="White" BackgroundColor="#88000000"
                    SemanticProperties.Description="Chiudi la superficie a tutto schermo" />
            <Border Grid.Column="1" IsVisible="{Binding IsSeries}" HorizontalOptions="Center" VerticalOptions="Center"
                    Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 16" BackgroundColor="#AA000000">
                <Label Text="{Binding PositionText}" TextColor="White" FontSize="14" FontAttributes="Bold" LineBreakMode="NoWrap" />
            </Border>
            <Button Grid.Column="2" IsVisible="{Binding IsSeries}" Text="{Binding ViewText}" Command="{Binding CycleViewCommand}"
                    HeightRequest="40" CornerRadius="20" Padding="12,0" FontSize="12" TextColor="White" BackgroundColor="#88000000"
                    SemanticProperties.Description="Cambia la vista: superficie continua, frame acquisiti, foto reale" />
        </Grid>

        <!-- I dati della moneta toccata -->
        <Border IsVisible="{Binding HasDetail}" VerticalOptions="End" Margin="{Binding DetailMargin}" Padding="12,8" StrokeThickness="0"
                StrokeShape="RoundRectangle 12" BackgroundColor="#B81A1A1E">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding DetailText}" TextColor="White" FontSize="12" LineBreakMode="WordWrap" />
                <Button Text="✎ Modifica" Command="{Binding EditCommand}" HorizontalOptions="Fill" HeightRequest="40" CornerRadius="20"
                        FontSize="14" TextColor="White" BackgroundColor="{StaticResource Primary}"
                        SemanticProperties.Description="Correggi questa moneta: valore errato, doppione, non è una moneta" />
            </VerticalStackLayout>
        </Border>

        <!-- Serie di scatti: totali, frecce per scorrere le superfici, un altro scatto, fine -->
        <Border IsVisible="{Binding IsSeries}" VerticalOptions="End" Margin="12,0,12,24" Padding="10,8" StrokeThickness="0"
                StrokeShape="RoundRectangle 16" BackgroundColor="#CC1A1A1E">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding SeriesTotalText}" TextColor="#DDFFFFFF" FontSize="12" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                    <Button Text="◀" Command="{Binding PreviousCommand}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                            FontSize="18" TextColor="White" BackgroundColor="#55FFFFFF"
                            SemanticProperties.Description="Superficie precedente" />
                    <Button Grid.Column="1" Text="📷 Altro scatto" Command="{Binding AnotherShotCommand}" HeightRequest="44" CornerRadius="22" Padding="8,0"
                            FontSize="13" TextColor="White" BackgroundColor="{StaticResource Primary}"
                            SemanticProperties.Description="Un altro scatto su un'altra parte del tavolo" />
                    <Button Grid.Column="2" Text="Fine" Command="{Binding DoneCommand}" HeightRequest="44" CornerRadius="22" Padding="16,0"
                            FontSize="13" TextColor="White" BackgroundColor="#55FFFFFF"
                            SemanticProperties.Description="Fine della serie: torna all'elenco delle sessioni" />
                    <Button Grid.Column="3" Text="▶" Command="{Binding NextCommand}" WidthRequest="44" HeightRequest="44" CornerRadius="22" Padding="0"
                            FontSize="18" TextColor="White" BackgroundColor="#55FFFFFF"
                            SemanticProperties.Description="Superficie successiva" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="White"
                           HorizontalOptions="Center" VerticalOptions="Center" HeightRequest="44" />
    </Grid>
</ContentPage>
