<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiveCoinCounter.ViewModels"
             x:Class="LiveCoinCounter.Views.SettingsPage"
             Title="Impostazioni"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Titolo sezione -->
            <Label Text="🤖 METODO DI RICONOSCIMENTO"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   LetterSpacing="1" />

            <!-- Card configurazione -->
            <Border Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="12">

                    <Picker Title="Metodo"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            FontSize="14"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                    <Label Text="{Binding ProviderNote}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />

                    <Entry Placeholder="{Binding ApiKeyPlaceholder}"
                           Text="{Binding ApiKey}"
                           IsVisible="{Binding ShowApiKey}"
                           IsPassword="True"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                    <Entry Placeholder="Modello (vuoto = predefinito)"
                           Text="{Binding Model}"
                           IsVisible="{Binding ShowModel}"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                    <Entry Placeholder="https://indirizzo-del-server/v1"
                           Text="{Binding BaseUrl}"
                           IsVisible="{Binding ShowBaseUrl}"
                           Keyboard="Url"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="💾 Salva"
                                Command="{Binding SaveCommand}"
                                CornerRadius="10" />

                        <Button Grid.Column="1"
                                Text="🔌 Testa"
                                Command="{Binding TestCommand}"
                                BackgroundColor="{StaticResource Secondary}"
                                CornerRadius="10" />
                    </Grid>

                    <Button Text="Ottieni API Key"
                            Command="{Binding OpenKeyPageCommand}"
                            IsVisible="{Binding HasKeyUrl}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Secondary}"
                            FontSize="12" />

                    <!-- Feedback salvataggio / test -->
                    <Label Text="{Binding StatusText}"
                           IsVisible="{Binding HasStatus}"
                           FontSize="13"
                           LineBreakMode="WordWrap"
                           HorizontalTextAlignment="Center"
                           TextColor="#2ecc71">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="TextColor" Value="#e74c3c" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>

                </VerticalStackLayout>
            </Border>

            <!-- Raccolta facoltativa di foto per migliorare il modello -->
            <Label Text="🧪 MIGLIORA IL RICONOSCIMENTO"
                   FontSize="11" FontAttributes="Bold" Margin="20,12,20,4"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />
            <Border Margin="16,0,16,8" Padding="16"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Salva le foto analizzate sul telefono" FontSize="14" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                        <Switch Grid.Column="1" IsToggled="{Binding CollectPhotos}" />
                    </Grid>
                    <Label Text="Spento di default. Le foto non lasciano il telefono: puoi esportarle tu, quando vuoi, per addestrare un modello migliore."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Label Text="{Binding CollectedSummary}" FontSize="12" />
                    <Button Text="📤 Esporta foto raccolte" Command="{Binding ExportPhotosCommand}"
                            IsVisible="{Binding HasCollectedPhotos}" CornerRadius="10"
                            BackgroundColor="{StaticResource Secondary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Titolo sezione informazioni -->
            <Label Text="ℹ️ INFORMAZIONI"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   LetterSpacing="1"
                   Margin="0,8,0,0" />

            <!-- Card info -->
            <Border Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🤖" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Metodo attivo" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="{Binding ModelSummary}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🪙" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Monete supportate" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="Euro: 1ct, 2ct, 5ct, 10ct, 20ct, 50ct, 1€, 2€" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🔒" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Privacy" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="{Binding PrivacyText}" 
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Versione -->
            <Label Text="{Binding FooterText}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

