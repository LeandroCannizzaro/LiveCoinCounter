<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiveCoinCounter.ViewModels"
             x:Class="LiveCoinCounter.Views.MainPage"
             Title="Conteggio Monete"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <!-- Toolbar con impostazioni e reset -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" Command="{Binding OpenSettingsCommand}" />
        <ToolbarItem Text="↺" Command="{Binding ResetCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

            <!-- ============================================================
                 SEZIONE 1: Anteprima immagine
                 ============================================================ -->
            <Border Margin="16,16,16,8"
                    StrokeThickness="2"
                    Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}"
                    StrokeShape="RoundRectangle 16">
                <Grid HeightRequest="260">

                    <!-- Placeholder quando non c'è immagine -->
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         IsVisible="{Binding CapturedImage, Converter={StaticResource NullToBoolConverter}}">
                        <Label Text="🪙" FontSize="64" HorizontalOptions="Center" />
                        <Label Text="Nessuna immagine" 
                               FontSize="14"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Immagine catturata -->
                    <Image Source="{Binding CapturedImage}"
                           Aspect="AspectFit"
                           IsVisible="{Binding CapturedImage, Converter={StaticResource NotNullToBoolConverter}}" />

                    <!-- Overlay di caricamento -->
                    <Grid IsVisible="{Binding IsAnalyzing}"
                          BackgroundColor="#AA000000">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                            <ActivityIndicator IsRunning="{Binding IsAnalyzing}"
                                              Color="White"
                                              HeightRequest="48" WidthRequest="48" />
                            <Label Text="Analisi AI in corso..." 
                                   TextColor="White" FontSize="16" FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================================================
                 SEZIONE 2: Status message
                 ============================================================ -->
            <Label Text="{Binding StatusMessage}"
                   Margin="16,4,16,8"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" />

            <!-- ============================================================
                 SEZIONE 3: Pulsanti azione
                 ============================================================ -->
            <Grid Margin="16,0,16,12" ColumnSpacing="8" ColumnDefinitions="*,*,*">

                <!-- Scatta foto -->
                <Button Grid.Column="0"
                        Text="📷 Scatta"
                        Command="{Binding TakePhotoCommand}"
                        FontSize="13"
                        CornerRadius="12"
                        IsEnabled="{Binding IsIdle}" />

                <!-- Carica da galleria -->
                <Button Grid.Column="1"
                        Text="🖼 Galleria"
                        Command="{Binding PickPhotoCommand}"
                        FontSize="13"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource Secondary}"
                        IsEnabled="{Binding IsIdle}" />

                <!-- Analizza -->
                <Button Grid.Column="2"
                        Text="🔍 Analizza"
                        Command="{Binding AnalyzeCommand}"
                        FontSize="13"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource Tertiary}"
                        IsEnabled="{Binding IsIdle}" />
            </Grid>

            <!-- Avviso del rilevatore + scorciatoia all'AI (visibili solo quando servono) -->
            <Border IsVisible="{Binding HasWarning}"
                    Margin="16,0,16,12" Padding="14,10"
                    StrokeThickness="1" Stroke="#FF9800"
                    BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#3E2A10}"
                    StrokeShape="RoundRectangle 12">
                <Label Text="{Binding Warning}" FontSize="13"
                       TextColor="{AppThemeBinding Light=#7A4A00, Dark=#FFCC80}" />
            </Border>

            <Button Text="🌐 Riprova con l'AI"
                    Command="{Binding RetryWithAiCommand}"
                    IsVisible="{Binding CanRetryWithAi}"
                    Margin="16,0,16,12" FontSize="13" CornerRadius="12"
                    BackgroundColor="#FF9800" TextColor="Black" />

            <!-- ============================================================
                 SEZIONE 4: Riepilogo totale (visibile solo dopo analisi)
                 ============================================================ -->
            <Border IsVisible="{Binding HasResult}"
                    Margin="16,4,16,12"
                    Padding="20,16"
                    StrokeThickness="0"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="TOTALE MONETE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#CCFFFFFF"
                               CharacterSpacing="1" />
                        <Label Text="{Binding TotalValue}"
                               FontSize="40"
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End" Spacing="2">
                        <Label Text="{Binding TotalCoins, StringFormat='{0}'}"
                               FontSize="32"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalTextAlignment="End" />
                        <Label Text="monete"
                               FontSize="12"
                               TextColor="#CCFFFFFF"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ============================================================
                 SEZIONE 5: Dettaglio per denominazione
                 ============================================================ -->
            <VerticalStackLayout IsVisible="{Binding HasResult}"
                                  Margin="16,0,16,0"
                                  Spacing="6">

                <Label Text="DETTAGLIO PER DENOMINAZIONE"
                       FontSize="11"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                       CharacterSpacing="1"
                       Margin="0,0,0,4" />

                <CollectionView ItemsSource="{Binding CoinResults}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6"
                                    Padding="14,10"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                    <!-- Emoji moneta -->
                                    <Label Grid.Column="0"
                                           Text="🪙"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           Margin="0,0,10,0" />

                                    <!-- Denominazione -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Denomination}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                                        <Label Text="{Binding DenominationFormatted}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                    </VerticalStackLayout>

                                    <!-- Quantità -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="{StaticResource Primary}"
                                            StrokeShape="RoundRectangle 20"
                                            StrokeThickness="0"
                                            Padding="10,4"
                                            VerticalOptions="Center"
                                            Margin="8,0">
                                        <Label Text="{Binding Count, StringFormat='×{0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>

                                    <!-- Valore totale denominazione -->
                                    <Label Grid.Column="3"
                                           Text="{Binding TotalValueFormatted}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{StaticResource Primary}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button Text="👎 Il conteggio è sbagliato"
                    Command="{Binding ReportWrongCommand}"
                    IsVisible="{Binding CanReportWrong}"
                    Margin="16,12,16,0" FontSize="12" CornerRadius="12"
                    BackgroundColor="Transparent"
                    BorderWidth="1"
                    BorderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />

            <!-- ============================================================
                 SEZIONE 6: Suggerimento iniziale
                 ============================================================ -->
            <VerticalStackLayout IsVisible="{Binding HasResult, Converter={StaticResource InvertBoolConverter}}"
                                  Margin="16,20,16,0"
                                  Spacing="8">

                <Border Padding="16"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="💡 Suggerimenti per un buon risultato"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                        <Label FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="• Usa una superficie piatta e ben illuminata&#10;" />
                                    <Span Text="• Disponi le monete senza sovrapporle eccessivamente&#10;" />
                                    <Span Text="• Fotografa dall'alto (vista dall'alto)&#10;" />
                                    <Span Text="• Tieni il telefono fermo per evitare blur&#10;" />
                                    <Span Text="• Funziona meglio con monete Euro" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

