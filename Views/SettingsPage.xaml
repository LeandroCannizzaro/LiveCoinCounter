<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LiveCoinCounter.ViewModels"
             x:Class="LiveCoinCounter.Views.SettingsPage"
             Title="Impostazioni"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ContentPage.BindingContext>
        <vm:SettingsViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- Titolo sezione -->
            <Label Text="🔑 API KEY GEMINI"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   LetterSpacing="1" />

            <!-- Card API Key -->
            <Border Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="12">

                    <Label FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Inserisci la tua chiave API di " />
                                <Span Text="Google AI Studio" FontAttributes="Bold" />
                                <Span Text=" per abilitare il riconoscimento AI delle monete." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Entry Placeholder="AIza..."
                           Text="{Binding ApiKey}"
                           IsPassword="True"
                           FontSize="14"
                           BackgroundColor="Transparent"
                           PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="💾 Salva"
                                Command="{Binding SaveCommand}"
                                CornerRadius="10" />

                        <Button Grid.Column="1"
                                Text="Ottieni API Key"
                                Command="{Binding OpenAiStudioCommand}"
                                BackgroundColor="{StaticResource Secondary}"
                                CornerRadius="10"
                                FontSize="12" />
                    </Grid>

                    <!-- Feedback salvataggio -->
                    <Label Text="✅ Chiave salvata con successo!"
                           IsVisible="{Binding IsSaved}"
                           TextColor="#2ecc71"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />

                </VerticalStackLayout>
            </Border>

            <!-- Titolo sezione informazioni -->
            <Label Text="ℹ️ INFORMAZIONI"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                   LetterSpacing="1"
                   Margin="0,8,0,0" />

            <!-- Card info -->
            <Border Padding="16"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource Gray800}}">
                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🤖" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Modello AI" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="Gemini 2.0 Flash" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🪙" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Monete supportate" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="Euro: 1ct, 2ct, 5ct, 10ct, 20ct, 50ct, 1€, 2€" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray700}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🔒" FontSize="18" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Privacy" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray800}, Dark=White}" />
                            <Label Text="Le immagini vengono inviate all'API Gemini per l'analisi e non vengono memorizzate localmente." 
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Versione -->
            <Label Text="LiveCoinCounter v1.0 · Powered by Gemini AI"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

